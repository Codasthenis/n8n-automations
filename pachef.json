      "name": "Get Skill Ids"
    },
    {
      "parameters": {
        "jsCode": "// ۱. همه آیتم‌ها رو بگیر\nconst allItems = $input.all();\n\n// ۲. آرایه‌های data همه آیتم‌ها رو با هم ادغام کن\nconst allSkills = allItems.flatMap(item => item.json.data || []);\n\nvar skills = \"\";\nfor (const key in allSkills) {\n  skills += \"&skillIds[\" + key + \"]=\" + allSkills[key].id\n}\nreturn [\n  {\n    \"url\": \"https://www.karlancer.com/api/publics/search/projects?order=newest\" + skills\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "id": "f7a18f49-333d-40ac-b756-31231c297ac1",
      "name": "Make Project Search Request"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst lastProjectId = staticData.lastProjectId || 0;\n\nvar output = [];\n\nif ($input.first().json.data.data[0].id > lastProjectId){\n  output = $input.first().json.data.data[0]\n  staticData.lastProjectId = $input.first().json.data.data[0].id\n}\n\nreturn output"
      },
