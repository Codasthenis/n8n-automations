    {
      "parameters": {
        "jsCode": "var urls = [];\nfor (const key in $input.first().json.skills) {\n  urls.push( \n    {\n      json: {\n        \"url\": \"https://www.karlancer.com/api/publics/skills/auto-complete?s=\"+$input.first().json.skills[key]\n      }\n    } \n  );\n  \n}\nreturn urls;"
      },
